{
  "name": "@private-polis/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app": {
      "types": "./src/app.ts",
      "default": "./src/app.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && esbuild src/index.ts --bundle --platform=node --format=cjs --external:pg-native --outfile=dist/index.cjs",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.cjs",
    "test": "vitest run",
    "test:integration": "RUN_POSTGRES_INTEGRATION=1 vitest run src/postgres.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.6",
    "@better-auth/sso": "^1.7.6",
    "@hono/node-server": "^2.0.0",
    "@hono/zod-validator": "^0.7.3",
    "@private-polis/contracts": "workspace:*",
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.9.9",
    "pg": "^8.16.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.5",
    "esbuild": "^0.28.0",
    "tsx": "^4.20.6"
  }
}
