{
  "name": "private-polis",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "db:generate": "pnpm --filter @private-polis/server db:generate",
    "db:migrate": "pnpm --filter @private-polis/server db:migrate",
    "dev": "pnpm --parallel --filter @private-polis/server --filter @private-polis/web dev",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
