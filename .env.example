# SSO provider IDs allowed to link an existing account with the same email.
ACCOUNT_LINKING_ALLOWED_PROVIDERS=[]
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_API_MAX=300
