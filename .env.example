PORT=3000
BETTER_AUTH_SECRET=development-only-change-me-32-characters
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173
INITIAL_ADMIN_EMAIL=
REGISTRATION_ENABLED=true
LOCAL_AUTH_ENABLED=true
